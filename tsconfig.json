{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["es2022"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "riblt": ["packages/riblt/src/index.ts"],
      "@riblt/setsync": ["packages/setsync/src/index.ts"],
      "@riblt/orp": ["packages/orp/src/index.ts"]
    }
  }
}
