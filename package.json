{
  "name": "riblt",
  "version": "0.0.1",
  "description": "Rateless Invertible Bloom Lookup Tables (RIBLT) in TypeScript; includes UUID+SHA256 document helpers.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/doc-uuid256.ts src/uuid.ts --dts --format esm,cjs --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "lint": "tsc --noEmit",
    "prepare": "pnpm build"
  },
  "keywords": [
    "riblt",
    "iblt",
    "set reconciliation",
    "sync"
  ],
  "author": "Naisho GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://example.com/your/repo.git"
  },
  "devDependencies": {
    "@esbuild/darwin-x64": "^0.27.2",
    "@rollup/rollup-darwin-x64": "^4.57.1",
    "@types/node": "^25.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "xxh3-ts": "^2.0.1"
  }
}
