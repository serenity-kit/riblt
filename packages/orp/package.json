{
  "name": "@riblt/orp",
  "version": "0.0.1",
  "description": "Operation Reconciliation Protocol interfaces and validators.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serenity-kit/orp.git"
  },
  "bugs": {
    "url": "https://github.com/serenity-kit/orp/issues"
  },
  "homepage": "https://github.com/serenity-kit/orp/tree/main/packages/orp#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
